# Copy this file to .env and change the password.
# .env is git-ignored so real credentials never get committed.

# Used by docker-compose.yml to create the database
POSTGRES_USER=steam
POSTGRES_PASSWORD=change_me
POSTGRES_DB=steam_reviews

# Used by Python code running on your machine to connect to that database
DATABASE_URL=postgresql://steam:change_me@localhost:5432/steam_reviews
